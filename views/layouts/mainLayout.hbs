<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/assets/css/bootstrap/bootstrap.min.css">
    <link rel="icon" type="image/svg+xml" href="/assets/images/book-placeholder.svg">
    <title>{{pageTitle}}</title>
</head>

<body>

<nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
<div class="container-fluid">
    <a class="navbar-brand" href="/">BookApp</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarCollapse">
    <ul class="navbar-nav mx-auto mb-2 mb-md-0">
        <li class="nav-item">
        <a class="nav-link {{#if homeActive}}active{{/if}}" aria-current="page" href="/">Catálogo</a>
        </li>
        <li class="nav-item">
        <a class="nav-link {{#if libroActive}}active{{/if}}" href="/libros-list">Libros</a>
        </li>
        <li class="nav-item">
        <a class="nav-link {{#if categoriaActive}}active{{/if}}" href="/categorias-list">Categorias</a>
        </li>
        <li class="nav-item">
        <a class="nav-link {{#if autorActive}}active{{/if}}" href="/autores-list">Autores</a>
        </li>
        <li class="nav-item">
        <a class="nav-link {{#if editorialActive}}active{{/if}}" href="/editoriales-list">Editoriales</a>
        </li>
    </ul>
    <form class="d-flex mb-2 mb-md-0" role="search" method="GET" action="/">
        <input class="form-control me-2" type="search" placeholder="Buscar por título" aria-label="Buscar libros" name="search">
        <button class="btn btn-outline-success" type="submit">Buscar</button>
    </form>
</div>
</nav>

<main class="container">
{{#if demoMode}}<div class="alert alert-info" role="status">Demo de solo lectura con datos ficticios. Puedes explorar y buscar; guardar, eliminar, subir archivos y enviar correos están desactivados.</div>{{/if}}

{{{body}}}

</main>

<script src="/assets/js/bootstrap/bootstrap.bundle.min.js"></script>
</body>
</html>
