# Copiar a .env para uso local. En alwaysdata utilizar las variables del sitio.
NODE_ENV=production
DEMO_MODE=true
MAIL_ENABLED=false
# alwaysdata define IP y PORT; no sobrescribirlos allí.
HOST=127.0.0.1
PORT=3000
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=bookapp_demo
MYSQLUSER=bookapp_demo
MYSQLPASSWORD=REEMPLAZAR_LOCALMENTE
# Solo configurar si MAIL_ENABLED=true y DEMO_MODE=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
